//@version=6
// =============================================================================================
// Hedge-Grade TTrades Fractal Engine
// A non-repainting, multi-timeframe implementation of the TTrades Fractal Model (TTFM) /
// ICT Power of Three (PO3) delivery-cycle framework, with the Candle 2 (C2) swing extreme
// anchored on an intermarket SMT (Smart Money Technique) divergence rather than an isolated
// pivot-high/low formula: HTF SMT crack (C2) -> LTF CISD confirmation (C4) -> Fibonacci
// expansion targets, predictive T-Spots, formation liquidity, HTF miniature candles, and a
// minimalist status table.
//
// NON-REPAINT POLICY:
//   - Every request.security() call below either (a) reads a historically offset value
//     (expr[1], expr[2]) so the merged series only ever reflects fully closed HTF bars, or
//     (b) reads a value that is fixed for the lifetime of the forming bar (open, time_close),
//     which cannot repaint even though the bar itself is unconfirmed.
//   - lookahead is always barmerge.lookahead_off. lookahead_on is never used.
//   - State-machine transitions (C2 SMT lock, CISD/C4, failure, consolidation) are only
//     evaluated using confirmed data, so once drawn/labeled they do not move or disappear.
// =============================================================================================
indicator("Hedge-Grade TTrades Fractal Engine", shorttitle = "HG-TTFM", overlay = true,
     max_labels_count = 40, max_boxes_count = 40, max_lines_count = 40, max_bars_back = 500)

// ================================================================= INPUTS: TIMEFRAME / PO3 ===
grpTF = "Timeframe & PO3 Session Management"
i_htf          = input.timeframe("60",  "Higher Timeframe (HTF)",            group = grpTF)
i_useHtf2      = input.bool(true,       "Enable Stack Confirmation (HTF2)",  group = grpTF)
i_htf2         = input.timeframe("240", "HTF2 (Stack Confirmation TF)",      group = grpTF)
i_showVLines   = input.bool(true,       "Show HTF Period Divider Lines",     group = grpTF)
i_showHtfOpen  = input.bool(true,       "Show HTF Open Price Line",          group = grpTF)

grpSMT = "Intermarket SMT Correlation (C2 Anchor)"
i_smtSym1 = input.symbol("XAGUSD", "Correlation Asset 1", group = grpSMT)
i_smtSym2 = input.symbol("XAUEUR", "Correlation Asset 2", group = grpSMT)
i_smtSym3 = input.symbol("XAUGBP", "Correlation Asset 3", group = grpSMT)

grpKZ = "Kill Zone Session Filters"
i_kz1On   = input.bool(true,  "Enable Kill Zone 1", group = grpKZ, inline = "kz1")
i_kz1     = input.session("0200-0500", "London",     group = grpKZ, inline = "kz1")
i_kz2On   = input.bool(true,  "Enable Kill Zone 2", group = grpKZ, inline = "kz2")
i_kz2     = input.session("0930-1100", "NY AM",      group = grpKZ, inline = "kz2")
i_kz3On   = input.bool(false, "Enable Kill Zone 3", group = grpKZ, inline = "kz3")
i_kz3     = input.session("1330-1600", "NY PM",      group = grpKZ, inline = "kz3")
i_sessTZ  = input.string("America/New_York", "Session Timezone", group = grpKZ)

grpBias = "Bias & History"
i_bias    = input.string("Neutral", "Analyst Bias", options = ["Bullish", "Bearish", "Neutral"], group = grpBias)
i_history = input.int(5, "Setup History Count (0-40)", minval = 0, maxval = 40, group = grpBias)

// =========================================================== INPUTS: PROJECTIONS / T-SPOT ===
grpProj = "Fibonacci Expansion Targets"
i_showProj = input.bool(true, "Show Projection Targets", group = grpProj)
i_lvl1On = input.bool(true,  "", group = grpProj, inline = "l1")
i_lvl1   = input.float(-1.0, "Level 1", group = grpProj, inline = "l1")
i_lvl2On = input.bool(true,  "", group = grpProj, inline = "l2")
i_lvl2   = input.float(-2.0, "Level 2", group = grpProj, inline = "l2")
i_lvl3On = input.bool(true,  "", group = grpProj, inline = "l3")
i_lvl3   = input.float(-2.5, "Level 3", group = grpProj, inline = "l3")
i_lvl4On = input.bool(false, "", group = grpProj, inline = "l4")
i_lvl4   = input.float(-4.0, "Level 4", group = grpProj, inline = "l4")
i_lvl5On = input.bool(false, "", group = grpProj, inline = "l5")
i_lvl5   = input.float(-4.5, "Level 5", group = grpProj, inline = "l5")

grpVis = "T-Spot, Equilibrium & Liquidity"
i_showTspot = input.bool(true, "Show T-Spot Zone",        group = grpVis)
i_showEQ    = input.bool(true, "Show Candle Equilibrium", group = grpVis)
i_showLiq   = input.bool(true, "Show Formation Liquidity (PDH/PDL)", group = grpVis)
i_showC1Liq = input.bool(true, "Show C2 Extreme Liquidity Ray", group = grpVis)

grpMini = "HTF Miniature Candlesticks (PO3)"
i_showMini   = input.bool(true, "Show HTF Mini Candles", group = grpMini)
i_miniCount  = input.int(8, "Mini Candle Count", minval = 1, maxval = 20, group = grpMini)
i_miniSize   = input.float(1.0, "Mini Candle Body Width", minval = 0.5, maxval = 5.0, group = grpMini)
i_miniOffX   = input.int(20, "Right Margin Offset (bars)", minval = 1, group = grpMini)
i_miniSpace  = input.int(3,  "Candle Spacing (bars)", minval = 1, group = grpMini)

grpTbl = "Institutional Data Table"
i_showTable = input.bool(true, "Show Data Table", group = grpTbl)
i_tablePos  = input.string("Middle Right", "Table Position",
     options = ["Top Right", "Middle Right", "Bottom Right", "Bottom Left", "Top Left"], group = grpTbl)
i_tableSize = input.string("Small", "Table Text Size", options = ["Tiny", "Small", "Normal"], group = grpTbl)

grpAlert = "Alerts"
i_alertCISD = input.bool(true, "Alert on CISD Confirmation",  group = grpAlert)
i_alertFail = input.bool(true, "Alert on Setup Failure",      group = grpAlert)
i_alertTgt  = input.bool(true, "Alert on Target Hit",         group = grpAlert)
i_alertStk  = input.bool(true, "Alert on Stack Confirmation", group = grpAlert)

// Fixed color palette (minimalist, monochrome structure + soft directional fills)
col_valid    = color.new(color.gray, 0)
col_failed   = color.new(color.red, 0)
col_consol   = color.new(color.orange, 0)
col_bull     = color.new(color.teal, 0)
col_bear     = color.new(color.maroon, 0)
col_rayFade  = color.new(color.gray, 25)
col_textFade = color.new(color.gray, 15)
col_tableTxt = color.rgb(70, 70, 70)

// ============================================================================= HTF FEEDS =====
// All offset expressions are evaluated INSIDE request.security() (expr[n]) so the merged
// series is built from fully closed HTF bars only -> guaranteed non-repainting. Time-based
// fields are explicitly cast to int since request.security() always returns series float.
hO0         = request.security(syminfo.tickerid, i_htf, open, lookahead = barmerge.lookahead_off)
hCloseTime0 = int(request.security(syminfo.tickerid, i_htf, time_close, lookahead = barmerge.lookahead_off))

// Candle offset [1] = the most recently closed HTF candle -> this is the new C2 anchor.
hO1 = request.security(syminfo.tickerid, i_htf, open[1],  lookahead = barmerge.lookahead_off)
hH1 = request.security(syminfo.tickerid, i_htf, high[1],  lookahead = barmerge.lookahead_off)
hL1 = request.security(syminfo.tickerid, i_htf, low[1],   lookahead = barmerge.lookahead_off)
hC1 = request.security(syminfo.tickerid, i_htf, close[1], lookahead = barmerge.lookahead_off)
hT1 = int(request.security(syminfo.tickerid, i_htf, time[1], lookahead = barmerge.lookahead_off))

// Candle offset [2] = the prior HTF candle, used only as the SMT comparison reference.
hH2 = request.security(syminfo.tickerid, i_htf, high[2], lookahead = barmerge.lookahead_off)
hL2 = request.security(syminfo.tickerid, i_htf, low[2],  lookahead = barmerge.lookahead_off)

// Lighter HTF2 feed, used only for stack (confluence) confirmation
h2H1 = request.security(syminfo.tickerid, i_htf2, high[1], lookahead = barmerge.lookahead_off)
h2L1 = request.security(syminfo.tickerid, i_htf2, low[1],  lookahead = barmerge.lookahead_off)
h2T1 = int(request.security(syminfo.tickerid, i_htf2, time[1], lookahead = barmerge.lookahead_off))
h2O2 = request.security(syminfo.tickerid, i_htf2, open[2],  lookahead = barmerge.lookahead_off)
h2H2 = request.security(syminfo.tickerid, i_htf2, high[2],  lookahead = barmerge.lookahead_off)
h2L2 = request.security(syminfo.tickerid, i_htf2, low[2],   lookahead = barmerge.lookahead_off)
h2C2 = request.security(syminfo.tickerid, i_htf2, close[2], lookahead = barmerge.lookahead_off)
h2H3 = request.security(syminfo.tickerid, i_htf2, high[3],  lookahead = barmerge.lookahead_off)
h2L3 = request.security(syminfo.tickerid, i_htf2, low[3],   lookahead = barmerge.lookahead_off)

// Formation liquidity: prior daily high/low (fully closed daily bar only)
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_off)

// Intermarket SMT correlation feeds (same HTF, same [1]/[2] blocks as the base symbol so
// every comparison is apples-to-apples within the identical time period).
s1H1 = request.security(i_smtSym1, i_htf, high[1], lookahead = barmerge.lookahead_off)
s1H2 = request.security(i_smtSym1, i_htf, high[2], lookahead = barmerge.lookahead_off)
s1L1 = request.security(i_smtSym1, i_htf, low[1],  lookahead = barmerge.lookahead_off)
s1L2 = request.security(i_smtSym1, i_htf, low[2],  lookahead = barmerge.lookahead_off)

s2H1 = request.security(i_smtSym2, i_htf, high[1], lookahead = barmerge.lookahead_off)
s2H2 = request.security(i_smtSym2, i_htf, high[2], lookahead = barmerge.lookahead_off)
s2L1 = request.security(i_smtSym2, i_htf, low[1],  lookahead = barmerge.lookahead_off)
s2L2 = request.security(i_smtSym2, i_htf, low[2],  lookahead = barmerge.lookahead_off)

s3H1 = request.security(i_smtSym3, i_htf, high[1], lookahead = barmerge.lookahead_off)
s3H2 = request.security(i_smtSym3, i_htf, high[2], lookahead = barmerge.lookahead_off)
s3L1 = request.security(i_smtSym3, i_htf, low[1],  lookahead = barmerge.lookahead_off)
s3L2 = request.security(i_smtSym3, i_htf, low[2],  lookahead = barmerge.lookahead_off)

newHtfBar  = ta.change(hT1) != 0
newHtf2Bar = ta.change(h2T1) != 0
newDay     = ta.change(time("D")) != 0

// ===================================================================== SESSION FILTERING =====
f_inSession(string sess) =>
    not na(time(timeframe.period, sess, i_sessTZ))

bool anyKZOn = i_kz1On or i_kz2On or i_kz3On
bool kz1Match = i_kz1On and f_inSession(i_kz1)
bool kz2Match = i_kz2On and f_inSession(i_kz2)
bool kz3Match = i_kz3On and f_inSession(i_kz3)
bool inKillZone = anyKZOn ? (kz1Match or kz2Match or kz3Match) : true

// =========================================================== GARBAGE-COLLECTED DRAWING SETS ==
// Every drawing object is tagged with the integer id of the setup that produced it. When a
// new setup begins we purge every drawing whose tag falls outside the user's History window,
// keeping total live object counts far below the hard max_*_count = 40 engine caps.
var array<label> g_labels     = array.new<label>()
var array<int>   g_labelSetup = array.new<int>()
var array<box>   g_boxes      = array.new<box>()
var array<int>   g_boxSetup   = array.new<int>()
var array<line>  g_lines      = array.new<line>()
var array<int>   g_lineSetup  = array.new<int>()
var int currentSetupId = 0

f_track_label(label lbl, int setupId) =>
    array.push(g_labels, lbl)
    array.push(g_labelSetup, setupId)

f_track_box(box b, int setupId) =>
    array.push(g_boxes, b)
    array.push(g_boxSetup, setupId)

f_track_line(line ln, int setupId) =>
    array.push(g_lines, ln)
    array.push(g_lineSetup, setupId)

f_prune_history(int cutoffId) =>
    while array.size(g_labelSetup) > 0 and array.get(g_labelSetup, 0) < cutoffId
        label.delete(array.shift(g_labels))
        array.shift(g_labelSetup)
    while array.size(g_boxSetup) > 0 and array.get(g_boxSetup, 0) < cutoffId
        box.delete(array.shift(g_boxes))
        array.shift(g_boxSetup)
    while array.size(g_lineSetup) > 0 and array.get(g_lineSetup, 0) < cutoffId
        line.delete(array.shift(g_lines))
        array.shift(g_lineSetup)

// =============================================================== ACTIVE SETUP STATE MACHINE ==
var string setupDir      = na    // "bull" / "bear"
var string setupState    = "none" // "valid" / "failed" / "consolidation"
var float  c2Extreme     = na
var float  c2Open        = na
var float  c2Eq          = na    // midpoint of the C2 candle range
var float  c2Close       = na
var int    c2Time        = na
var bool   cisdConfirmed = false
var float  cisdVector    = na
var int    deadline      = na    // HTF close-time deadline for the consolidation check
var label  c2Lbl = na
var label  c4Lbl = na
var box    tspotBox = na
var line   eqLine = na
var line   c1LiqLine = na
var line   cisdLine = na
var array<line>  projLineArr  = array.new<line>(5, na)
var array<label> projLabelArr = array.new<label>(5, na)
var array<float> projPriceArr = array.new<float>(5, na)
var array<bool>  projHitArr   = array.new<bool>(5, false)
var array<bool>  projOnArr    = array.new<bool>(5, false)

// HTF2 stack state (T-Spot only, used for confluence confirmation)
var float t2Top = na
var float t2Bot = na
var bool  stackFlag = false

// Table status snapshot (updated every bar, rendered on the last bar only)
var string lastAlertState = "None"

// One-shot event flags for alertcondition(): declared without `var`, so each auto-resets to
// false at the start of every bar, then latched true only on the exact bar an event fires.
bool bearCisdEvent = false
bool bullCisdEvent = false
bool failEvent     = false
bool stackEvent    = false

f_reset_projections() =>
    for i = 0 to 4
        ln = array.get(projLineArr, i)
        lb = array.get(projLabelArr, i)
        if not na(ln)
            line.delete(ln)
        if not na(lb)
            label.delete(lb)
        array.set(projLineArr, i, na)
        array.set(projLabelArr, i, na)
        array.set(projPriceArr, i, na)
        array.set(projHitArr, i, false)
        array.set(projOnArr, i, false)

// ---------------------------------------------------------------- HTF2 pivot / T-Spot (light)
if i_useHtf2 and newHtf2Bar
    bool sh2 = h2H2 > h2H1 and h2H2 > h2H3
    bool sl2 = h2L2 < h2L1 and h2L2 < h2L3
    if sh2
        float mid2 = (h2H2 + h2L2) / 2.0
        t2Top := h2C2
        t2Bot := mid2
    else if sl2
        float mid2b = (h2H2 + h2L2) / 2.0
        t2Top := mid2b
        t2Bot := h2C2

// ------------------------------------------------------ New HTF C2 detection: SMT crack only
// C2 is no longer an isolated 3-bar pivot. It anchors on the most recently closed HTF candle
// ([1]) ONLY when the base symbol confirms a new extreme relative to the prior HTF candle
// ([2]) while at least one correlated asset FAILS to confirm the same extreme in that same
// time block -- a verified intermarket SMT divergence ("crack in correlation").
if newHtfBar and inKillZone
    bool baseHigherHigh = hH1 >= hH2
    bool baseLowerLow    = hL1 <= hL2

    bool s1FailHigh = s1H1 < s1H2
    bool s2FailHigh = s2H1 < s2H2
    bool s3FailHigh = s3H1 < s3H2
    bool s1FailLow  = s1L1 > s1L2
    bool s2FailLow  = s2L1 > s2L2
    bool s3FailLow  = s3L1 > s3L2

    bool bearSMT = baseHigherHigh and (s1FailHigh or s2FailHigh or s3FailHigh)
    bool bullSMT = baseLowerLow and (s1FailLow or s2FailLow or s3FailLow)

    bool allowBear = i_bias == "Bearish" or i_bias == "Neutral"
    bool allowBull = i_bias == "Bullish" or i_bias == "Neutral"

    if (bearSMT and allowBear) or (bullSMT and allowBull)
        // Archive/prune anything older than the configured history window
        currentSetupId += 1
        f_prune_history(currentSetupId - i_history)

        setupDir := bearSMT ? "bear" : "bull"
        setupState := "valid"
        cisdConfirmed := false
        stackFlag := false
        c2Extreme := setupDir == "bear" ? hH1 : hL1
        c2Open    := hO1
        c2Close   := hC1
        c2Eq      := (hH1 + hL1) / 2.0
        c2Time    := hT1
        cisdVector := na
        deadline := int(na)

        // Minimalist marker: tiny plain text, no filled background/border, gray/red/orange
        // state-machine color carried purely through the text color.
        c2Lbl := label.new(x = c2Time, y = c2Extreme, xloc = xloc.bar_time,
             text = "C2", style = setupDir == "bear" ? label.style_label_down : label.style_label_up,
             color = color.new(col_valid, 100), textcolor = col_valid, size = size.tiny)
        f_track_label(c2Lbl, currentSetupId)

        if i_showEQ
            eqLine := line.new(x1 = c2Time, y1 = c2Eq, x2 = hCloseTime0, y2 = c2Eq, xloc = xloc.bar_time,
                 extend = extend.right, color = color.new(color.blue, 55), style = line.style_dashed, width = 1)
            f_track_line(eqLine, currentSetupId)

        if i_showTspot
            float tTop = math.max(c2Close, c2Eq)
            float tBot = math.min(c2Close, c2Eq)
            color tFill   = setupDir == "bear" ? color.new(color.red, 90) : color.new(color.green, 90)
            color tBorder = setupDir == "bear" ? color.new(color.red, 80) : color.new(color.green, 80)
            tspotBox := box.new(left = c2Time, top = tTop, right = hCloseTime0, bottom = tBot, xloc = xloc.bar_time,
                 extend = extend.right, border_color = tBorder, border_width = 1, bgcolor = tFill)
            f_track_box(tspotBox, currentSetupId)

        if i_showC1Liq
            c1LiqLine := line.new(x1 = c2Time, y1 = c2Extreme, x2 = hCloseTime0, y2 = c2Extreme, xloc = xloc.bar_time,
                 extend = extend.right, color = col_rayFade, style = line.style_dotted, width = 1)
            f_track_line(c1LiqLine, currentSetupId)

// --------------------------------------------------------------------------- HTF open line ---
var line htfOpenLine = na
if i_showHtfOpen and newHtfBar
    if not na(htfOpenLine)
        line.delete(htfOpenLine)
    htfOpenLine := line.new(x1 = time, y1 = hO0, x2 = time + 1, y2 = hO0, xloc = xloc.bar_time,
         extend = extend.right, color = color.new(color.yellow, 30), style = line.style_solid, width = 1)

// --------------------------------------------------------------------- HTF period dividers ---
// Clean thin full-height vertical lines separating each HTF open/high/low/close block.
if i_showVLines and newHtfBar
    line.new(x1 = time, y1 = high, x2 = time, y2 = low, xloc = xloc.bar_time,
         extend = extend.both, color = color.new(color.gray, 70), style = line.style_solid, width = 1)

// ============================================================================ CISD LOGIC =====
if not na(setupDir) and setupState != "failed" and not cisdConfirmed and inKillZone
    bool cisdBear = setupDir == "bear" and close < c2Open
    bool cisdBull = setupDir == "bull" and close > c2Open

    if cisdBear or cisdBull
        cisdConfirmed := true
        cisdVector := math.abs(c2Extreme - c2Open)
        deadline := hCloseTime0
        bearCisdEvent := setupDir == "bear"
        bullCisdEvent := setupDir == "bull"

        cisdLine := line.new(x1 = c2Time, y1 = c2Open, x2 = time, y2 = c2Open, xloc = xloc.bar_time,
             extend = extend.none, color = setupDir == "bear" ? col_bear : col_bull,
             style = line.style_dashed, width = 2)
        f_track_line(cisdLine, currentSetupId)

        c4Lbl := label.new(x = time, y = close, xloc = xloc.bar_time,
             text = "C4", style = setupDir == "bear" ? label.style_label_down : label.style_label_up,
             color = color.new(col_valid, 100), textcolor = col_valid, size = size.tiny)
        f_track_label(c4Lbl, currentSetupId)

        if i_showProj
            array<bool>  onFlags = array.from(i_lvl1On, i_lvl2On, i_lvl3On, i_lvl4On, i_lvl5On)
            array<float> lvlVals = array.from(i_lvl1, i_lvl2, i_lvl3, i_lvl4, i_lvl5)
            for i = 0 to 4
                if array.get(onFlags, i)
                    float lvl = array.get(lvlVals, i)
                    float tgt = setupDir == "bear" ? c2Open + lvl * cisdVector : c2Open - lvl * cisdVector
                    array.set(projPriceArr, i, tgt)
                    array.set(projOnArr, i, true)
                    // Thin dotted horizontal ray with the level number printed in tiny,
                    // faded text immediately above the line.
                    ln = line.new(x1 = time, y1 = tgt, x2 = time + 1, y2 = tgt, xloc = xloc.bar_time,
                         extend = extend.right, color = col_rayFade, style = line.style_dotted, width = 1)
                    lb = label.new(x = time, y = tgt, xloc = xloc.bar_time,
                         text = str.tostring(lvl, "#.##"), style = label.style_label_down,
                         color = color.new(color.gray, 100), textcolor = col_textFade, size = size.tiny)
                    array.set(projLineArr, i, ln)
                    array.set(projLabelArr, i, lb)
                    f_track_line(ln, currentSetupId)
                    f_track_label(lb, currentSetupId)

        if i_alertCISD
            alert("HG-TTFM: CISD confirmed (" + setupDir + ") on " + syminfo.ticker, alert.freq_once_per_bar_close)

        // Stack confirmation: does the LTF CISD open sit inside the HTF2 T-Spot zone?
        if i_useHtf2 and not na(t2Top) and not na(t2Bot)
            float zTop = math.max(t2Top, t2Bot)
            float zBot = math.min(t2Top, t2Bot)
            stackFlag := c2Open <= zTop and c2Open >= zBot
            if stackFlag
                stackEvent := true
                if i_alertStk
                    alert("HG-TTFM: Stack confirmation (LTF/HTF2 T-Spot overlap) on " + syminfo.ticker, alert.freq_once_per_bar_close)

// ---------------------------------------------------------------------- Target hit tracking --
if cisdConfirmed and setupState == "valid"
    for i = 0 to 4
        if array.get(projOnArr, i) and not array.get(projHitArr, i)
            float tgt = array.get(projPriceArr, i)
            bool hit = setupDir == "bear" ? low <= tgt : high >= tgt
            if hit
                array.set(projHitArr, i, true)
                if i_alertTgt
                    alert("HG-TTFM: Target " + str.tostring(i + 1) + " hit on " + syminfo.ticker, alert.freq_once_per_bar_close)

// -------------------------------------------------------------------------- Failure detection
if not na(setupDir) and setupState != "failed"
    bool failedBear = setupDir == "bear" and close > c2Extreme
    bool failedBull = setupDir == "bull" and close < c2Extreme
    if failedBear or failedBull
        setupState := "failed"
        failEvent := true
        if not na(c2Lbl)
            label.set_color(c2Lbl, col_failed)
        if not na(c4Lbl)
            label.set_color(c4Lbl, col_failed)
        // Failure purges targets, EQ, T-Spot and liquidity wicks from the active render
        // matrix immediately, but the C2/C4 labels remain on chart (recolored red) as the
        // historical record. This inline block (not a function) reassigns global object
        // vars, which Pine only permits at top level, not from inside a user function.
        if not na(tspotBox)
            box.delete(tspotBox)
            tspotBox := na
        if not na(eqLine)
            line.delete(eqLine)
            eqLine := na
        if not na(c1LiqLine)
            line.delete(c1LiqLine)
            c1LiqLine := na
        if not na(cisdLine)
            line.delete(cisdLine)
            cisdLine := na
        f_reset_projections()
        if i_alertFail
            alert("HG-TTFM: Setup FAILED (" + setupDir + ") on " + syminfo.ticker, alert.freq_once_per_bar_close)

// ---------------------------------------------------------------------- Consolidation check --
if newHtfBar and setupState == "valid" and cisdConfirmed and not na(deadline)
    bool target1Hit = array.size(projHitArr) > 0 and array.get(projOnArr, 0) and array.get(projHitArr, 0)
    if hT1 >= deadline and not target1Hit
        setupState := "consolidation"
        if not na(c2Lbl)
            label.set_color(c2Lbl, col_consol)
        if not na(c4Lbl)
            label.set_color(c4Lbl, col_consol)

lastAlertState := setupState == "none" ? "None" : setupState == "valid" ? "Valid" : setupState == "failed" ? "Failed" : "Consolidation"

// =============================================================== FORMATION LIQUIDITY (PDH/PDL)
if i_showLiq and newDay
    line.new(x1 = time, y1 = pdh, x2 = time + 1, y2 = pdh, xloc = xloc.bar_time,
         extend = extend.right, color = col_rayFade, style = line.style_dotted, width = 1)
    line.new(x1 = time, y1 = pdl, x2 = time + 1, y2 = pdl, xloc = xloc.bar_time,
         extend = extend.right, color = col_rayFade, style = line.style_dotted, width = 1)

// ======================================================= HTF MINIATURE CANDLES (PO3 SCHEMATIC)
var array<float> miniO = array.new<float>()
var array<float> miniH = array.new<float>()
var array<float> miniL = array.new<float>()
var array<float> miniC = array.new<float>()
var array<box>   miniBodies = array.new<box>()
var array<line>  miniWicks  = array.new<line>()

if newHtfBar
    array.push(miniO, hO1)
    array.push(miniH, hH1)
    array.push(miniL, hL1)
    array.push(miniC, hC1)
    if array.size(miniO) > i_miniCount
        array.shift(miniO)
        array.shift(miniH)
        array.shift(miniL)
        array.shift(miniC)

if i_showMini and barstate.islast
    // Pine's for-loop reverses direction when the end index is below the start index, so a
    // plain "0 to size-1" bound still executes once on an empty array (size-1 = -1) and
    // throws an out-of-bounds error. Guard each loop on a non-empty array first.
    if array.size(miniBodies) > 0
        for i = 0 to array.size(miniBodies) - 1
            box.delete(array.get(miniBodies, i))
    if array.size(miniWicks) > 0
        for i = 0 to array.size(miniWicks) - 1
            line.delete(array.get(miniWicks, i))
    array.clear(miniBodies)
    array.clear(miniWicks)

    int n = array.size(miniO)
    int bodyWidth = int(math.max(1.0, math.round(i_miniSize)))
    if n > 0
        for i = 0 to n - 1
            int xBase = bar_index + i_miniOffX + i * i_miniSpace
            float o_ = array.get(miniO, i)
            float h_ = array.get(miniH, i)
            float l_ = array.get(miniL, i)
            float c_ = array.get(miniC, i)
            color bodyCol = c_ >= o_ ? color.new(color.teal, 10) : color.new(color.maroon, 10)
            b = box.new(left = xBase, top = math.max(o_, c_), right = xBase + bodyWidth, bottom = math.min(o_, c_),
                 xloc = xloc.bar_index, bgcolor = bodyCol, border_color = bodyCol)
            w = line.new(x1 = xBase, y1 = h_, x2 = xBase, y2 = l_, xloc = xloc.bar_index,
                 color = bodyCol, width = 1)
            array.push(miniBodies, b)
            array.push(miniWicks, w)

// ========================================================================= DATA TABLE ========
f_tablePos(string p) =>
    switch p
        "Top Right"    => position.top_right
        "Middle Right" => position.middle_right
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        "Top Left"     => position.top_left
        => position.middle_right

f_tableSize(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        => size.small

f_pad2(int v) =>
    v < 10 ? "0" + str.tostring(v) : str.tostring(v)

f_tfLabel(string tf) =>
    string lbl = tf
    if tf == "D"
        lbl := "1D"
    else if tf == "W"
        lbl := "1W"
    else if tf == "M"
        lbl := "1M"
    else
        float minsF = str.tonumber(tf)
        if not na(minsF)
            int mins = int(minsF)
            lbl := mins >= 60 and mins % 60 == 0 ? str.tostring(int(mins / 60)) + "H" : str.tostring(mins) + "m"
    lbl

var table infoTable = table.new(f_tablePos(i_tablePos), 1, 4,
     border_width = 1, border_color = color.new(color.gray, 55))

if i_showTable and barstate.islast
    string modelTitle = f_tfLabel(timeframe.period) + "-" + f_tfLabel(i_htf) + " Model"

    int remainMs = na(hCloseTime0) ? int(na) : hCloseTime0 - timenow
    bool haveRemain = not na(remainMs) and remainMs >= 0
    int hh = haveRemain ? int(math.floor(remainMs / 3600000)) : int(na)
    int mm = haveRemain ? int(math.floor((remainMs % 3600000) / 60000)) : int(na)
    int ss = haveRemain ? int(math.floor((remainMs % 60000) / 1000)) : int(na)
    string countdown = haveRemain ? f_pad2(hh) + ":" + f_pad2(mm) + ":" + f_pad2(ss) : "--:--:--"

    string biasText = "Bias: " + i_bias

    string kzText = ""
    if i_kz1On
        kzText += (kzText == "" ? "" : "/") + i_kz1
    if i_kz2On
        kzText += (kzText == "" ? "" : "/") + i_kz2
    if i_kz3On
        kzText += (kzText == "" ? "" : "/") + i_kz3
    if kzText == ""
        kzText := "All Hours"

    color bgCol = color.new(color.gray, 88)

    table.cell(infoTable, 0, 0, modelTitle, text_color = col_tableTxt, bgcolor = bgCol, text_size = f_tableSize(i_tableSize))
    table.cell(infoTable, 0, 1, countdown,  text_color = col_tableTxt, bgcolor = bgCol, text_size = f_tableSize(i_tableSize))
    table.cell(infoTable, 0, 2, biasText,   text_color = col_tableTxt, bgcolor = bgCol, text_size = f_tableSize(i_tableSize))
    table.cell(infoTable, 0, 3, kzText,     text_color = col_tableTxt, bgcolor = bgCol, text_size = f_tableSize(i_tableSize))

// ============================================================================== ALERTS =======
alertcondition(bearCisdEvent, title = "CISD Bearish",    message = "HG-TTFM: Bearish CISD confirmed")
alertcondition(bullCisdEvent, title = "CISD Bullish",    message = "HG-TTFM: Bullish CISD confirmed")
alertcondition(failEvent,     title = "Setup Failed",    message = "HG-TTFM: Active setup failed")
alertcondition(stackEvent,    title = "Stack Confirmed", message = "HG-TTFM: LTF/HTF2 T-Spot stack confirmed")
